<Project>

  <!--
    Shared build configuration for Identity Posture Assessor.
    Every project targets .NET 10 LTS (supported through November 2028).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Reproducible / deterministic release metadata. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1031;CA2007;CA1062;CA1002;CA1819</NoWarn>
  </PropertyGroup>

  <!-- Product identity. Branding is centralised so it can be re-skinned per release. -->
  <PropertyGroup>
    <Product>Identity Posture Assessor</Product>
    <Company>NoBrain Software</Company>
    <Authors>NoBrain Software</Authors>
    <Copyright>Copyright (c) NoBrain Software</Copyright>
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RepositoryUrl>https://github.com/NoBrain-Soft/entra-ad-audit-tool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Supported runtime identifiers for self-contained publishing. -->
  <PropertyGroup>
    <SupportedRuntimeIdentifiers>win-x64;linux-x64</SupportedRuntimeIdentifiers>
  </PropertyGroup>

</Project>
