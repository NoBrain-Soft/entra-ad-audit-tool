<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.subheading">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D8DBE0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="Border.warning">
    <Setter Property="Background" Value="#FFF6E5" />
    <Setter Property="BorderBrush" Value="#D9A441" />
  </Style>

  <Style Selector="Border.critical">
    <Setter Property="Background" Value="#FDECEF" />
    <Setter Property="BorderBrush" Value="#A4243B" />
  </Style>

  <Style Selector="TextBlock.score">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, 'DejaVu Sans Mono', monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

</Styles>
