<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ipa.Desktop.ViewModels"
             x:Class="Ipa.Desktop.Views.ScopeView"
             x:DataType="vm:ScopeViewModel">

  <StackPanel Spacing="12" MaxWidth="920" HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Select all" Command="{Binding SelectAllCommand}" />
      <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
      <TextBlock VerticalAlignment="Center" Classes="muted">
        <Run Text="{Binding SelectedRuleCount}" />
        <Run Text="rule(s) will be evaluated." />
      </TextBlock>
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CheckGroupViewModel">
          <Border Classes="card" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Permissions}" Classes="mono" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted">
                <Run Text="{Binding RuleCount}" />
                <Run Text="rules" />
              </TextBlock>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button Content="Continue to collection" Command="{Binding ContinueCommand}" HorizontalAlignment="Left" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="#A4243B" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

  </StackPanel>
</UserControl>
